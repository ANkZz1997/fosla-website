# TEMPLATE ONLY. This file is committed to GitHub, so never put real passwords or keys in it.
# Put real values in .env (private, git-ignored). Run `npm run setup:env` to create it and generate the secrets.

# ---------- Access ----------
# Password for the /admin dashboard (10+ characters)
ADMIN_PASSWORD=change-me
# Random string used to sign the admin session cookie (generated by setup:env)
SESSION_SECRET=change-me
# Vercel sends this as "Authorization: Bearer <CRON_SECRET>" to /api/cron/run (generated; must differ from SESSION_SECRET)
CRON_SECRET=change-me

# ---------- Storage (REQUIRED on Vercel: remembers what was already posted) ----------
# Add the "Upstash Redis" integration from the Vercel Marketplace; it sets these for you.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------- Public links ----------
# Your channel link, e.g. https://whatsapp.com/channel/XXXXXXXX (WhatsApp > Updates > your channel > Share)
WHATSAPP_CHANNEL_URL=
# Your Instagram page, e.g. https://instagram.com/yourhandle (button is hidden if empty)
INSTAGRAM_URL=

# ---------- Posting ----------
# manual = posts wait in the dashboard for you to copy/paste (safe, no WhatsApp connection needed)
# bridge = app sends to your self-hosted WhatsApp bridge (see bridge/README.md)
PUBLISH_MODE=manual
# Only with PUBLISH_MODE=bridge: post automatically without review
AUTO_POST=false
BRIDGE_URL=
BRIDGE_TOKEN=

# ---------- Optional: Claude reads messy job pages for better post-wise seat tables ----------
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5

# ---------- Tuning ----------
MAX_NEW_PER_RUN=6
# only_hp = only Himachal jobs, all = every source item
JOB_SCOPE=all
# Public URL of this deployment, e.g. https://fosla-jobs.vercel.app (Vercel fills this in automatically if empty)
APP_URL=
